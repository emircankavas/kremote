# XcodeGen output — never commit the generated project.
*.xcodeproj
*.xcworkspace

# Build products
build/
.build/
.build-xcode/
DerivedData/

# SwiftPM checkouts for the local package
Packages/KRemoteCore/.build/

# Xcode user state
xcuserdata/
*.xcuserstate

# SwiftPM
.swiftpm/
Package.resolved

# But keep the dependency mirrors that point third-party packages at the Forgejo
# copies: without this file swift-crypto's transitive swift-asn1 dependency is
# still fetched from github.com.
!Packages/KRemoteCore/.swiftpm/
!Packages/KRemoteCore/.swiftpm/configuration/
!Packages/KRemoteCore/.swiftpm/configuration/mirrors.json

# macOS
.DS_Store

# Local secrets
*.local.xcconfig

# Worker scratch (transient)
.scratch/
